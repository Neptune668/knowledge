# ===== 应用 =====
APP_NAME=kami-backend
DEBUG=false
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ===== 数据库（容器内会被 docker-compose 覆盖为服务名）=====
DATABASE_URL=postgresql+asyncpg://root:1234@postgres:5432/kami

# ===== Redis =====
REDIS_URL=redis://redis:6379/0

# ===== 向量化 API（OpenAI 调用方式）=====
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIM=1024

# ===== Milvus（外部已有服务）=====
MILVUS_URL=
CHUNKS_COLLECTION=kb_chunks

# ===== LLM API =====
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== 检索工作流 =====
RECALL_TOP_K=8
RETRIEVE_MIN_SCORE=0.55
MAX_RETRY=2

# ===== 沉淀阈值 =====
FAQ_MINE_THRESHOLD=3
FAQ_SIM_THRESHOLD=0.92
GAP_SIM_THRESHOLD=0.55
