# ===== 应用 =====
APP_NAME=kami-backend
DEBUG=false
SECRET_KEY=please-change-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=

# ===== PostgreSQL =====
POSTGRES_USER=root
POSTGRES_PASSWORD=please-change-db-password
POSTGRES_DB=kami

# ===== 后端连接配置（容器网络内部）=====
DATABASE_URL=postgresql+asyncpg://root:please-change-db-password@postgres:5432/kami
REDIS_URL=redis://redis:6379/0

# ===== Milvus（容器内服务名）=====
MILVUS_URL=http://milvus:19530
CHUNKS_COLLECTION=kb_chunks

# ===== 向量化 API（算力云 FastAPI 映射的 URL，OpenAI 兼容 /embeddings）=====
EMBEDDING_API_URL=http://<算力云IP>:<端口>/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIM=1024

# ===== LLM API（OpenAI 兼容协议）=====
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== 检索工作流 =====
RECALL_TOP_K=8
RETRIEVE_MIN_SCORE=0.55
MAX_RETRY=2

# ===== 沉淀阈值 =====
FAQ_MINE_THRESHOLD=3
FAQ_SIM_THRESHOLD=0.92
GAP_SIM_THRESHOLD=0.55
