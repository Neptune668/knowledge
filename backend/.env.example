# 应用
APP_NAME=kami-backend
DEBUG=false
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 数据库
DATABASE_URL=postgresql+asyncpg://kami:kami@localhost:5432/kami

# Redis
REDIS_URL=redis://localhost:6379/0

# 向量化 API（暂用外部 API）
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# LLM API（OpenAI 兼容协议，可切换）
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# 检索工作流
RECALL_TOP_K=8
RETRIEVE_MIN_SCORE=0.55
MAX_RETRY=2

# 沉淀阈值
FAQ_MINE_THRESHOLD=3
FAQ_SIM_THRESHOLD=0.92
GAP_SIM_THRESHOLD=0.55
